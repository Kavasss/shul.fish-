# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НЕ попадает в репозиторий (см. .gitignore).

# Порт, на котором запускается сайт
PORT=3000

# Логин и пароль для входа в админ-панель (/admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Длинная случайная строка для подписи сессий.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Поставьте 1, если сайт работает по HTTPS (cookie будут помечены Secure)
COOKIE_SECURE=0

# (Необязательно) Уведомления о новых заказах в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
